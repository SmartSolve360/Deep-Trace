# =============================================================================
# DEEP-TRACE — Production Environment Template
# =============================================================================
#
# Render-specific notes:
#   - DATABASE_URL is provided automatically by Render via the linked
#     Postgres service in render.yaml. Don't override it.
#   - SECRET_KEY and the Postgres password are auto-generated by Render
#     in render.yaml.
#   - API_KEYS must be set manually in the Render dashboard (it's marked
#     `sync: false` because it's sensitive and you might rotate it).
#
# Generate fresh secrets:
#   SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(32))"
#   API_KEYS:       python -c "import secrets; print('prod_' + secrets.token_urlsafe(32))"
# =============================================================================

# --- Runtime ---
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true
# Replace with your Wix domain. Comma-separate if you have multiple
# (e.g. wixsite.com preview + custom domain).
CORS_ALLOW_ORIGINS=https://yoursite.wixsite.com,https://www.yourdomain.com

# --- Security ---
# 32+ byte random secret. Generate fresh for each deployment.
SECRET_KEY=__SET_ME_IN_RENDER_DASHBOARD__
# Comma-separated list of valid service-to-service API keys.
# At minimum, the key your Wix Velo backend uses (stored in Wix Secrets).
API_KEYS=__SET_ME_IN_RENDER_DASHBOARD__

# --- Database (auto-provided by Render via render.yaml) ---
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# --- Watermark ---
WATERMARK_QIM_DELTA=20.0
WATERMARK_ECC_SYMBOLS=32

# --- Forensic search thresholds (bit-Hamming distance, 0-64) ---
FORENSIC_MATCH_THRESHOLD_PHASH=8
FORENSIC_MATCH_THRESHOLD_DHASH=6
FORENSIC_MATCH_THRESHOLD_AHASH=6
FORENSIC_MATCH_THRESHOLD_WHASH=7
FORENSIC_DEFAULT_MAX_DISTANCE=10
FORENSIC_AUTO_MATCH_DISTANCE=10

# --- Rate limits ---
RATE_LIMIT_EMBED=10/minute
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_AUTHED=600/minute

# --- C2PA (optional, requires a CAI-issued cert in production) ---
# C2PA_SIGNING_KEY_PATH=/etc/secrets/c2pa/test_signer.key
# C2PA_SIGNING_CERT_PATH=/etc/secrets/c2pa/test_signer.cert
# C2PA_TRUST_ANCHORS_PATH=/etc/secrets/c2pa/ca.cert
