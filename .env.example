# DEEP-TRACE environment template.
# Copy to `.env` and fill in real values. Never commit `.env` to source control.

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ALLOW_ORIGINS=*

# --- Security ---
# 32+ byte master secret. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEEPTRACE_SECRET_KEY=dev_only_change_me_in_production_32b!
# Comma-separated list of allowed API keys
DEEPTRACE_API_KEYS=dev_api_key_change_me_in_production

# --- Database (asyncpg DSN) ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/deeptrace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=deeptrace

# --- Watermark ---
WATERMARK_QIM_DELTA=20.0
WATERMARK_ECC_SYMBOLS=32

# --- Forensic search thresholds (bit-Hamming distance, 0-64) ---
# Per-hash tolerances for perceptual-hash match decisions.
# Higher = more permissive. Tune for your forensic context:
#   * Legal evidence  → keep low (5-8) to minimise false positives
#   * Social media    → raise (10-15) to maximise recall
FORENSIC_MATCH_THRESHOLD_PHASH=8
FORENSIC_MATCH_THRESHOLD_DHASH=6
FORENSIC_MATCH_THRESHOLD_AHASH=6
FORENSIC_MATCH_THRESHOLD_WHASH=7
# Default used by /api/v1/ledger/search when not specified
FORENSIC_DEFAULT_MAX_DISTANCE=10
# Auto-match threshold used by /forensics/extract to decide MATCH_FOUND
FORENSIC_AUTO_MATCH_DISTANCE=10

# --- C2PA (optional) ---
# C2PA_SIGNING_KEY_PATH=/run/secrets/c2pa_key.pem
# C2PA_SIGNING_CERT_PATH=/run/secrets/c2pa_cert.pem
# C2PA_TRUST_ANCHORS_PATH=/run/secrets/c2pa_anchors.pem
